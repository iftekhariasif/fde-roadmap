{
    "permissions": {
        "allow": [
            "Bash(npm test)",
            "Bash(npm run lint)",
            "Bash(git status)",
            "Bash(git diff *)"
        ],
        "deny": [
            "Read(./.env)",
            "Bash(git push *)",
            "Bash(rm -rf *)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path' | xargs npx prettier --write"
                    }
                ]
            }
        ]
    }
}